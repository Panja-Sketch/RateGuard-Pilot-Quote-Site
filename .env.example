# Copy to .env ONLY if you load it yourself (the app reads process.env; it does not parse .env files).
# Never commit real values. Everything below is for synthetic, local/demo use.

PORT=3000
PILOT_DATA_DIR=./data
# PILOT_STORE=memory                    # ephemeral store (nothing written to disk)

# Demo identity (AUTH_MODE=demo). Defaults are documented in the README; override for any shared host.
# PILOT_DEMO_PASSWORD=
# PILOT_API_CLIENT_PASSWORD=
# PILOT_AUTH_SECRET=                    # token signing secret; generated into data/.auth-secret if unset

# Cross-origin callers (e.g. Firebase Hosting origin), comma separated
# PILOT_CORS_ORIGINS=https://<your-project>.web.app

# ---- Cloud mode (documented, not deployed; see docs/GOOGLE_CLOUD.md) ----
# AUTH_MODE=firebase                    # needs: npm i firebase-admin ; uses Application Default Credentials
# PILOT_STORE=firestore                 # needs: npm i @google-cloud/firestore
# PILOT_FIRESTORE_PREFIX=pilot_         # collection name prefix
# PILOT_BLOBS=gcs                       # needs: npm i @google-cloud/storage
# PILOT_GCS_BUCKET=<bucket-name>
# GOOGLE_CLOUD_PROJECT=<project-id>
