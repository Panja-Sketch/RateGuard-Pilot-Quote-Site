{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/**", "run": { "serviceId": "pilot-quote-api", "region": "us-central1" } },
      { "source": "/healthz", "run": { "serviceId": "pilot-quote-api", "region": "us-central1" } },
      { "source": "/shared/**", "run": { "serviceId": "pilot-quote-api", "region": "us-central1" } },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "emulators": {
    "auth": { "host": "127.0.0.1", "port": 9099 },
    "firestore": { "host": "127.0.0.1", "port": 8086 },
    "hosting": { "host": "127.0.0.1", "port": 5002 },
    "ui": { "enabled": false },
    "singleProjectMode": false
  }
}
